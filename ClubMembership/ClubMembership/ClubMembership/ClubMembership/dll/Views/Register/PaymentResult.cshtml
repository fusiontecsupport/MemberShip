@model ClubMembership.Models.OmniwarePaymentResultViewModel
@{
    Layout = null;
    var isSuccess = Model != null && Model.IsSuccess;
    var title = (Model != null && !string.IsNullOrEmpty(Model.Title)) ? Model.Title : "Payment result";
    var message = (Model != null && !string.IsNullOrEmpty(Model.Message)) ? Model.Message : "";
    var orderId = (Model != null && !string.IsNullOrEmpty(Model.OrderId)) ? Model.OrderId : "N/A";
    var transactionId = (Model != null && !string.IsNullOrEmpty(Model.TransactionId)) ? Model.TransactionId : "N/A";
    var responseCode = (Model != null && !string.IsNullOrEmpty(Model.ResponseCode)) ? Model.ResponseCode : "N/A";
    var paymentMode = (Model != null && !string.IsNullOrEmpty(Model.PaymentMode)) ? Model.PaymentMode : "N/A";
    var paymentChannel = (Model != null && !string.IsNullOrEmpty(Model.PaymentChannel)) ? Model.PaymentChannel : "N/A";
    var paymentDatetime = (Model != null && !string.IsNullOrEmpty(Model.PaymentDatetime)) ? Model.PaymentDatetime : "N/A";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        :root {
            --bg-1: #f5f7ff;
            --bg-2: #eef6ff;
            --card: #ffffff;
            --text: #0f172a;
            --muted: #64748b;
            --success: #16a34a;
            --success-bg: #dcfce7;
            --success-ink: #166534;
            --failure: #dc2626;
            --failure-bg: #fee2e2;
            --failure-ink: #991b1b;
            --accent: #2563eb;
            --border: #e2e8f0;
        }

        body {
            min-height: 100vh;
            margin: 0;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            color: var(--text);
            background:
                radial-gradient(circle at top left, rgba(37, 99, 235, 0.12), transparent 28%),
                radial-gradient(circle at bottom right, rgba(16, 185, 129, 0.10), transparent 26%),
                linear-gradient(135deg, var(--bg-1), var(--bg-2));
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }

        .result-shell {
            width: 100%;
            max-width: 760px;
        }

        .result-card {
            background: var(--card);
            border: 1px solid rgba(148, 163, 184, 0.2);
            border-radius: 28px;
            box-shadow: 0 24px 70px rgba(15, 23, 42, 0.12);
            overflow: hidden;
        }

        .result-topbar {
            height: 10px;
            background: linear-gradient(90deg, #22c55e, #16a34a);
        }

        .result-topbar.failure {
            background: linear-gradient(90deg, #f87171, #ef4444);
        }

        .result-body {
            padding: 28px;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            border-radius: 999px;
            font-weight: 700;
            margin-bottom: 18px;
            line-height: 1;
        }

        .status-pill.success {
            background: var(--success-bg);
            color: var(--success-ink);
        }

        .status-pill.failure {
            background: var(--failure-bg);
            color: var(--failure-ink);
        }

        .hero {
            display: grid;
            grid-template-columns: 88px 1fr;
            gap: 18px;
            align-items: center;
            margin-bottom: 24px;
        }

        .hero-icon {
            width: 88px;
            height: 88px;
            border-radius: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: inset 0 0 0 1px rgba(255,255,255,0.7);
        }

        .hero-icon.success {
            background: linear-gradient(145deg, #dcfce7, #bbf7d0);
            color: var(--success);
        }

        .hero-icon.failure {
            background: linear-gradient(145deg, #fee2e2, #fecaca);
            color: var(--failure);
        }

        .hero-title {
            font-size: clamp(1.9rem, 2.8vw, 2.5rem);
            font-weight: 800;
            margin: 0 0 8px;
            line-height: 1.05;
        }

        .hero-message {
            color: var(--muted);
            margin: 0;
            font-size: 1rem;
            line-height: 1.6;
        }

        .order-card {
            border: 1px solid var(--border);
            border-radius: 22px;
            background: linear-gradient(180deg, #fbfdff 0%, #f8fbff 100%);
            padding: 18px;
            margin-bottom: 18px;
        }

        .order-label {
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--muted);
            margin-bottom: 8px;
            font-weight: 700;
        }

        .order-value {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--accent);
            word-break: break-all;
            line-height: 1.25;
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
            margin-bottom: 24px;
        }

        .info-tile {
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 14px 16px;
            background: #fff;
        }

        .info-label {
            display: block;
            font-size: 0.78rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.09em;
            margin-bottom: 6px;
            font-weight: 700;
        }

        .info-value {
            font-weight: 700;
            color: var(--text);
            word-break: break-word;
        }

        .actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 8px;
        }

        .btn-rounded {
            border-radius: 14px;
            padding: 0.75rem 1.15rem;
            font-weight: 700;
        }

        @@media (max-width: 575.98px) {
            .result-body {
                padding: 18px;
            }

            .hero {
                grid-template-columns: 1fr;
            }

            .hero-icon {
                width: 74px;
                height: 74px;
            }

            .summary-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="result-shell">
        <div class="result-card">
            <div class="result-topbar @(isSuccess ? "" : "failure")"></div>
            <div class="result-body">
                <div class="status-pill @(isSuccess ? "success" : "failure")">
                    @if (isSuccess)
                    {
                        <span>&#10003;</span>
                        <span>Payment completed</span>
                    }
                    else
                    {
                        <span>!</span>
                        <span>Payment issue</span>
                    }
                </div>

                <div class="hero">
                    <div class="hero-icon @(isSuccess ? "success" : "failure")">
                        @if (isSuccess)
                        {
                            <svg width="42" height="42" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        }
                        else
                        {
                            <svg width="42" height="42" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M12 8v5" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" />
                                <path d="M12 16h.01" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" />
                                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.2" />
                            </svg>
                        }
                    </div>
                    <div>
                        <h1 class="hero-title">@title</h1>
                        <p class="hero-message">
                            @message
                        </p>
                    </div>
                </div>

                <div class="order-card">
                    <div class="order-label">Order ID</div>
                    <div class="order-value">@orderId</div>
                </div>

                <div class="summary-grid">
                    <div class="info-tile">
                        <span class="info-label">Transaction ID</span>
                        <div class="info-value">@transactionId</div>
                    </div>
                    <div class="info-tile">
                        <span class="info-label">Response Code</span>
                        <div class="info-value">@responseCode</div>
                    </div>
                    <div class="info-tile">
                        <span class="info-label">Payment Mode</span>
                        <div class="info-value">@paymentMode</div>
                    </div>
                    <div class="info-tile">
                        <span class="info-label">Payment Channel</span>
                        <div class="info-value">@paymentChannel</div>
                    </div>
                    <div class="info-tile" style="grid-column: 1 / -1;">
                        <span class="info-label">Payment Time</span>
                        <div class="info-value">@paymentDatetime</div>
                    </div>
                </div>

                <div class="actions">
                    <a href="@Url.Action("Login", "Account")" class="btn btn-primary btn-rounded">Go to Login</a>
                    <a href="@Url.Action("Index", "Register")" class="btn btn-outline-secondary btn-rounded">Back to Registration</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
