@using System.Collections.Generic
@model ClubMembership.Models.OmniwarePaymentRedirectViewModel
@{
    Layout = null;
    var fields = (Model != null && Model.Fields != null)
        ? Model.Fields
        : new Dictionary<string, string>();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redirecting to Payment Gateway</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            background: linear-gradient(135deg, #eef2ff 0%, #e0f2fe 100%);
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }
        .redirect-card {
            max-width: 560px;
            width: calc(100% - 2rem);
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 18px 48px rgba(15, 23, 42, 0.12);
            padding: 2rem;
            text-align: center;
        }
        .spinner-border {
            width: 3rem;
            height: 3rem;
        }
        .muted {
            color: #64748b;
        }
    </style>
</head>
<body>
    <div class="redirect-card">
        <div class="spinner-border text-primary mb-3" role="status" aria-hidden="true"></div>
        <h1 class="h4 mb-2">Redirecting to Omniware</h1>
        <p class="muted mb-4">Your registration is saved. Please wait while we open the payment gateway.</p>

        <form id="omniwareForm" action="@Model.ActionUrl" method="post">
            @foreach (var field in fields)
            {
                <input type="hidden" name="@field.Key" value="@field.Value" />
            }
            <noscript>
                <button type="submit" class="btn btn-primary">Continue to payment</button>
            </noscript>
        </form>
    </div>

    <script>
        window.onload = function () {
            document.getElementById('omniwareForm').submit();
        };
    </script>
</body>
</html>
